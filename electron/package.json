{
  "name": "routine-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.victor.routine",
    "productName": "Routine",
    "files": ["main.js", "preload.js", "web-dist/**/*"],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
